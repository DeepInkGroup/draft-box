{
  "name": "Draft Box",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Draft Box",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm --prefix server ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start.sh"
}
