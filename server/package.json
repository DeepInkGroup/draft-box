{
  "name": "draft-box-server",
  "version": "2.0.0",
  "description": "Backend for Draft Box - World Cup player draft & league game",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "gen:data": "node src/data/generate-teams-from-txt.js && node src/data/generate-pgl.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "socket.io-client": "^4.8.4"
  }
}
